# Copy this file to .env and enter credentials on your own computer.
# Never commit .env or paste API keys into the browser application.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=

# Web search service: https://tavily.com/
TAVILY_API_KEY=

# Optional email for the polite OpenAlex API pool.
OPENALEX_MAILTO=

# Optional: local web server port. The server always binds to 127.0.0.1.
MENTOR_PORT=8765
